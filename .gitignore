# --- Capture files: NEVER commit these ------------------------------------------
# The source captures show internal government systems and this repo is public.
# .gitignore alone does not stop `git add -f`, so .githooks/pre-commit enforces it too.
*.docx
*.doc
*.mht
*.mhtml
*.snagx
*.snag
*.pdf
*.pptx

# Working folders for real captures — keep them out of the tree entirely
/captures/
/samples/
/private/

# Screenshots are only allowed in assets/demo/ (synthetic) and docs/assets/ (README)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
!assets/demo/**
!docs/assets/**

# --- Node (dev-only tooling; nothing ships from here) ----------------------------
node_modules/
npm-debug.log*
.npm/

# --- Editors / OS ----------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Build/test output -----------------------------------------------------------
/coverage/
/out/
*.local

# tools/shoot.mjs output. The .png rule above already covers the screenshots, but
# this folder also holds the exported artifacts it downloads, and those inline every
# screenshot as base64 — run against a real capture, they are internal imagery in a
# .html. Ignore the whole directory rather than rely on the extension rules.
/tools/shots/
