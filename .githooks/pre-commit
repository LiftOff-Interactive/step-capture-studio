#!/bin/sh
#
# Leak guard. The repo is public; the source captures show internal government systems.
# Git history is permanent, so this blocks capture files BEFORE they are committed.
#
# Enabled by:  git config core.hooksPath .githooks
# Never bypass with --no-verify. If this hook is wrong, fix the hook.

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACMR)

[ -z "$staged" ] && exit 0

# --- 1. Capture and document formats that may embed screenshots -----------------
blocked=$(printf '%s\n' "$staged" | grep -Ei '\.(docx|doc|mht|mhtml|snagx|snag|pdf|pptx|zip)$')
if [ -n "$blocked" ]; then
  echo "BLOCKED: capture/document files must never be committed to this public repo:"
  printf '  %s\n' $blocked
  fail=1
fi

# --- 2. Anything under a captures/ or samples/ directory ------------------------
inpath=$(printf '%s\n' "$staged" | grep -Ei '(^|/)(captures?|samples?|private)/')
if [ -n "$inpath" ]; then
  echo "BLOCKED: files under captures/, samples/, or private/ are never committed:"
  printf '  %s\n' $inpath
  fail=1
fi

# --- 3. Images outside the allow-listed folders ---------------------------------
# Screenshots of internal systems are the real risk. Only assets/demo/ (synthetic
# demo capture) and docs/assets/ (README imagery) may contain images.
images=$(printf '%s\n' "$staged" | grep -Ei '\.(png|jpg|jpeg|gif|bmp|webp|tiff?)$' \
         | grep -Ev '^(assets/demo/|docs/assets/)')
if [ -n "$images" ]; then
  echo "BLOCKED: images are only allowed in assets/demo/ or docs/assets/:"
  printf '  %s\n' $images
  echo "  If this is genuinely synthetic, non-sensitive imagery, move it into one of those folders."
  fail=1
fi

# --- 4. Screenshots embedded INSIDE a text file ---------------------------------
# Checks 1-3 judge a file by its name. That was sufficient until this tool began
# emitting self-contained HTML with every screenshot inlined as a base64 data
# URI: a project file or artifact built from an internal capture is a `.html`
# full of internal screenshots, and every check above waves it through.
#
# Matched on a long base64 payload rather than the string "data:image", so the
# emitter and its tests — which mention data URIs but never contain one — are
# not caught. A real screenshot runs to tens of thousands of characters.
embedded=""
for file in $(printf '%s\n' "$staged" | grep -Ev '^(assets/demo/|docs/assets/)'); do
  git show ":$file" 2>/dev/null \
    | grep -qEi 'data:image/[a-z]+;base64,[A-Za-z0-9+/=]{200,}' && embedded="$embedded $file"
done
if [ -n "$embedded" ]; then
  echo "BLOCKED: these files contain embedded screenshots (base64 image data):"
  printf '  %s\n' $embedded
  echo "  Generated artifacts and project files inline every screenshot. If this was built"
  echo "  from an internal capture it must never be committed. Only a genuinely synthetic"
  echo "  demo belongs in assets/demo/."
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Nothing was committed. Unstage the files above with: git restore --staged <file>"
  echo "See CLAUDE.md and docs/decisions.md for why this rule exists."
  exit 1
fi

exit 0
